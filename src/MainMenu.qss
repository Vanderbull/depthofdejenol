/* Depths of Dejenol - Main Menu Stylesheet (Modern Dark Theme) */

/* Global font and background */
QApplication {
    font-family: "Noto Sans", "Arial", sans-serif;
    font-size: 16px;
}

QWidget {
    background-color: transparent;
}

/* Sidebar */
#sidebar {
    background-color: rgba(20, 20, 30, 220);
    border-right: 1px solid #444444;
    padding: 20px 0;
}

#sidebarTitleLabel {
    color: #ffd700;
    font-size: 26px;
    font-weight: bold;
    text-align: center;
    padding: 0 20px;
}

#sidebarContinueButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffd700, stop:1 #e6a817);
    color: #000000;
    border: none;
    border-radius: 10px;
    font-size: 22px;
    font-weight: bold;
    padding: 15px;
    text-align: center;
    margin: 10px 20px;
}

#sidebarContinueButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffe44d, stop:1 #f2b800);
}

#sidebarContinueSubtitleLabel {
    color: #ffd700;
    font-size: 16px;
    font-style: italic;
    text-align: center;
    padding: 5px 20px;
}

#sidebarButton {
    background-color: #2a2a3a;
    color: #cccccc;
    border: 1px solid #444444;
    border-radius: 8px;
    font-size: 18px;
    padding: 14px 20px;
    text-align: left;
    margin: 5px 20px;
}

#sidebarButton:hover {
    background-color: #3a3a4a;
    color: #ffffff;
}

/* Content area */
#content {
    background-color: rgba(10, 10, 20, 220);
    border: 1px solid #333333;
    padding: 30px;
}

#menuTitleLabel {
    color: #ffd700;
    font-size: 48px;
    font-weight: bold;
    text-align: center;
    margin-bottom: 20px;
}

#continueButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffd700, stop:1 #e6a817);
    color: #000000;
    border: none;
    border-radius: 12px;
    font-size: 28px;
    font-weight: bold;
    padding: 20px 60px;
    text-align: center;
    margin-bottom: 20px;
}

#continueButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffe44d, stop:1 #f2b800);
}

#continueSubtitleLabel {
    color: #ffd700;
    font-size: 22px;
    font-style: italic;
    text-align: center;
    margin-bottom: 20px;
}

#partyPreviewLabel {
    background-color: rgba(0, 0, 0, 120);
    border: 1px solid #555555;
    border-radius: 8px;
    color: #ffffff;
    font-size: 18px;
    padding: 15px 20px;
    text-align: center;
    margin-bottom: 20px;
}

#gridButton {
    background-color: #2a2a3a;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 8px;
    font-size: 18px;
    padding: 14px 20px;
    margin: 5px;
}

#gridButton:hover {
    background-color: #3a3a4a;
    color: #ffffff;
}

#gridButtonSmall {
    background-color: #2a2a3a;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 8px;
    font-size: 14px;
    padding: 10px 16px;
    margin: 5px;
}

#footerButton {
    background-color: #2a2a3a;
    color: #cccccc;
    border: 1px solid #444444;
    border-radius: 8px;
    font-size: 16px;
    padding: 12px 18px;
    margin: 5px;
}

#footerButton:hover {
    background-color: #3a3a4a;
    color: #ffffff;
}

#pressHintLabel, #pressHintLabelRight {
    color: #aaaaaa;
    font-size: 14px;
    text-align: center;
}

#logoLabel {
    background: none;
    border: none;
    padding: 0;
}

