#ifndef version_H
#define version_H

namespace GameConstants {
    // Build version pushed to Lua as GameVersion: "v" + commit count (e.g. "v778").
    // The git hash and timestamp are separate metadata below.
    static const char* const GIT_HASH = $$VERSION_HASH;
    static const char* const BUILD_TIMESTAMP = $$VERSION_DATE;
    static const char* const FULL_VERSION = $$VERSION_INT;
    // Semantic version for the release. Format: v<major>.<minor>.<patch>
    static const char* const SEMANTIC_VERSION = $$SEMVER;
}

#endif
